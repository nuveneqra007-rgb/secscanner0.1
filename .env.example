# ===========================================
# SecScanner 0.1 — Variables de Entorno
# ===========================================
# Copia este archivo a .env.local y completa con tus valores.
# NUNCA compartas ni hagas commit de .env.local.
# Todas las variables son opcionales individualmente; el sistema
# se degrada elegantemente si alguna no está presente.

# --- Fase 3: APIs con clave gratuita ---
# VirusTotal v3: 4 req/min, 500 req/día (https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=

# AbuseIPDB v2: 1,000 checks/día (https://www.abuseipdb.com/register)
ABUSEIPDB_API_KEY=

# --- Fase 4: Phishing y Threat Intelligence ---
# Google Safe Browsing Lookup v4 (Google Cloud Console -> Safe Browsing API)
GOOGLE_SAFEBROWSING_KEY=

# PhishTank (https://phishtank.com/register.php) - Opcional, mejora rate limits
PHISHTANK_APP_KEY=

# abuse.ch Auth-Key para URLhaus, ThreatFox y MalwareBazaar (https://auth.abuse.ch/)
ABUSECH_AUTH_KEY=

# --- Configuración del Servidor ---
RATE_LIMIT_MAX=10           # Límite de peticiones por minuto por IP
CACHE_TTL_MINUTES=30        # Tiempo de vida de la caché in-memory
NODE_ENV=development
